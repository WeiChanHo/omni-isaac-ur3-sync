# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Python environments
.venv/
venv/
env/

# Test, coverage, lint, and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Python packaging output
build/
dist/
*.egg-info/

# Isaac Sim / Omniverse local build output
_build/
_compiler/
_deps/
_generated/
_repo/

# Runtime logs and local caches
*.log
.cache/
logs/

# Local environment files (keep templates versioned)
.env
.env.*
!.env.example

# IDE and editor state
.idea/
.vscode/
*.swp
*.swo
*~

# Operating-system metadata
.DS_Store
Thumbs.db
